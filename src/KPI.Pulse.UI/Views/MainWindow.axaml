<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KPI.Pulse.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:KPI.Pulse.UI.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="930"
        MinHeight="930" WindowStartupLocation="CenterScreen"
        xmlns:rxui="http://reactiveui.net"
        xmlns:ui="clr-namespace:KPI.Pulse.UI"
        x:Class="KPI.Pulse.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/KPI-logo.ico"
        Title="KPI.Pulse.UI">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <rxui:RoutedViewHost Router="{Binding Router}">
        <rxui:RoutedViewHost.ViewLocator>
            <ui:AppViewLocator/>
        </rxui:RoutedViewHost.ViewLocator>
    </rxui:RoutedViewHost>

</Window>
