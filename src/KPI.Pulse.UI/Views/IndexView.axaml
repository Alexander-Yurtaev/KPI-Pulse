<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KPI.Pulse.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:KPI.Pulse.UI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="930"
             x:Class="KPI.Pulse.UI.Views.IndexView"
             x:DataType="vm:IndexViewModel"
             x:CompileBindings="True">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.container">
            <Setter Property="Background" Value="{StaticResource WindowGradient}"/>
        </Style>
        <Style Selector="Grid.container">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="Border.header">
            <Setter Property="Padding" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{StaticResource WindowGradient}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="100"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="500"/>
        </Style>
        <Style Selector="Border.badge TextBlock.icon">
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="700"/>
            <Setter Property="LineHeight" Value="52.8"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Foreground">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1a1f36" Offset="0"/>
                    <GradientStop Color="#434190" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#4a5568"/>
            <Setter Property="LineHeight" Value="28.8"/>
            <Setter Property="Margin" Value="0,0,0,30"/>
        </Style>
        <Style Selector="Border.platform">
            <Setter Property="Background" Value="#667eea"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="100"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style Selector="Border.platform TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="500"/>
        </Style>
        <Style Selector="ScrollViewer.nav">
            <Setter Property="Margin" Value="0,10"/>
        </Style>
        <Style Selector="Border.nav">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BoxShadow" Value="0 4 12 #0c000000"/>
        </Style>
        <Style Selector="Border.nav TextBlock.icon">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style Selector="Border.nav TextBlock.title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#1a1f36"/>
        </Style>
        <Style Selector="Border.nav TextBlock.subtitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style Selector="Border.tech-stack">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="0,30,0,0"/>
        </Style>
        <Style Selector="Border.tech-stack TextBlock.icon">
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style Selector="Border.tech-stack TextBlock.title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style Selector="Border.tech-icon">
        </Style>
        <Style Selector="Grid.footer-container">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,40,0,0"/>
        </Style>
        <Style Selector="TextBlock.footer">
            <Setter Property="Foreground" Value="#ccffffff"/>
        </Style>
        <Style Selector="Border.nav">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition
                        Property="RenderTransform"
                        Duration="0:0:0.3"
                        Easing="CubicEaseOut"/>

                    <BoxShadowsTransition
                        Property="BoxShadow"
                        Duration="0:0:0.3"
                        Easing="CubicEaseOut"/>

                    <BrushTransition
                        Property="BorderBrush"
                        Duration="0:0:0.3"
                        Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.nav:pointerover">
            <Setter Property="RenderTransform" Value="translate(0, -4px)"/>
            <Setter Property="BorderBrush" Value="#667eea"/>
            <Setter Property="BoxShadow" Value="0 20 30 #33667eea"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="container" Padding="20,40">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Row="0" Classes="card header">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" 
                            Grid.Row="0" 
                            Classes="badge">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Classes="icon" Text="⚡"/>
                            <TextBlock Classes="title" Text="Настольное приложение на Avalonia"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="h1" 
                               Grid.Column="0" 
                               Grid.ColumnSpan="2" 
                               Grid.Row="1">
                        KPI Pulse
                        Мониторинг ключевых показателей
                    </TextBlock>
                    <TextBlock Classes="subtitle" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" TextWrapping="WrapWithOverflow">
                        Компактное desktop-приложение для отслеживания KPI в реальном времени. Работает на Windows, Linux и macOS.
                    </TextBlock>
                    <ItemsControl Grid.Column="0" 
                                  Grid.ColumnSpan="2" 
                                  Grid.Row="3"
                                  ItemsSource="{Binding PlatformItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,30"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:PlatformItem">
                                <Border Grid.Column="0" Grid.Row="0" Classes="platform">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}"/>
                                        <TextBlock Text="{Binding Title}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" Classes="nav">
                <Border>
                    <Grid RowDefinitions="Auto,*">
                        <ItemsControl Grid.Row="0" 
                                      ItemsSource="{Binding NavItems}" 
                                      HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid ColumnSpacing="20" RowSpacing="20" Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:NavItem">
                                    <Button Command="{Binding DataContext.NavigateToNavItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" 
                                            CommandParameter="{Binding}"
                                            x:CompileBindings="False">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Border Classes="nav">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Classes="icon" Text="{Binding Icon}"/>
                                                        <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="WrapWithOverflow"/>
                                                        <TextBlock Classes="subtitle" Text="{Binding Subtitle}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </ScrollViewer>
            <Border Grid.Row="2" Classes="tech-stack">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Classes="icon" Text="🔧"/>
                        <TextBlock Grid.Column="1" Classes="title" Text="Используемые технологии"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TechItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding TechColumns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:TechItem">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Classes="tech-icon list-dot" Text="🔵" VerticalAlignment="Center" />
                                    <TextBlock Classes="tech-title" Text="{Binding Title}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <Grid Grid.Row="3" Classes="footer-container">
                <TextBlock Classes="footer" Text="© 2026 KPI Pulse · Настольное приложение для мониторинга KPI"></TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>